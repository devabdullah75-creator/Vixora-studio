# Local development defaults. Set NODE_ENV=production and APP_ORIGIN to your
# canonical HTTPS origin before deploying.
NODE_ENV=development
PORT=4174
APP_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-bytes
TRUST_PROXY=0
STORAGE_DIR=./storage
DATABASE_PATH=./storage/vixora-store.sqlite

# Set these only for the one-time admin:create command; never use sample values.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=